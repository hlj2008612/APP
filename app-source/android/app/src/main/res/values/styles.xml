<?xml version="1.0" encoding="utf-8"?>
<!--
  主题定义。图标/启动画面相关的改动集中在文件后半段，详见
  docs/app-icon-spec.md 第 3.4 节。

  ⚠️ 2026-10-25 用 aapt2 link 单独校验时发现：AppTheme 引用的
     @color/colorPrimary / colorPrimaryDark / colorAccent 在 values/ 里
     从来没有定义过。这种悬空引用会让整个 res 链接失败（Gradle 用 AGP 8.2.1
     也会报 AAPT2 error）。现已改为引用 values/colors.xml 的品牌色。
-->
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      启动画面主题。

      优先级（core-splashscreen 1.0.1，项目已依赖 coreSplashScreenVersion）：
        API 31+  → 用 android:windowSplashScreen* 系统属性（见 values-v31）
        API 26-30 → 用同名库属性，由库在 Activity 起来后自绘一块居中图标
        API 22-25 → 库不接管，只有 android:background 生效，即 drawable/splash.png

      原来只有 android:background：API 26~30 上没有任何居中图标，
      冷启动先整屏铺旧的 Capacitor 默认启动图，再切到深色 WebView。

      windowSplashScreenAnimatedIcon 用「前景层」而不是整图标：
      整图贴进来后系统还会再套一次遮罩，深底叠深底，圆角处会露出一圈。
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 兜底启动图（API < 26） -->
        <item name="android:background">@drawable/splash</item>

        <!-- API 26~30：交给 core-splashscreen 库 -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
